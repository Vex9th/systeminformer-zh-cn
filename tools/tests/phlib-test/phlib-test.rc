#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_UI_RESOURCE_TEST "English resource"
    IDS_UI_RESOURCE_ENGLISH_ONLY "English only"
END

IDD_UI_RESOURCE_TEST DIALOGEX 0, 0, 120, 40
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION
CAPTION "English dialog"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "English label", IDC_UI_RESOURCE_LABEL, 6, 8, 100, 12
END

IDD_UI_RESOURCE_PAGE_TEST DIALOGEX 0, 0, 120, 40
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
CAPTION "English page"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "English page label", IDC_UI_RESOURCE_LABEL, 6, 8, 100, 12
END

IDD_UI_RESOURCE_LEGACY_TEST DIALOGEX 0, 0, 120, 40
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION
CAPTION "General"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Options", IDC_UI_RESOURCE_LABEL, 6, 8, 100, 12
END

IDM_UI_RESOURCE_TEST MENU
BEGIN
    POPUP "English menu"
    BEGIN
        MENUITEM "English item", IDM_UI_RESOURCE_COMMAND
    END
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

STRINGTABLE
BEGIN
    IDS_UI_RESOURCE_TEST "中文资源"
END

IDD_UI_RESOURCE_TEST DIALOGEX 0, 0, 120, 40
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION
CAPTION "中文对话框"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "中文标签", IDC_UI_RESOURCE_LABEL, 6, 8, 100, 12
END

IDD_UI_RESOURCE_PAGE_TEST DIALOGEX 0, 0, 120, 40
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
CAPTION "中文属性页"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "中文属性页标签", IDC_UI_RESOURCE_LABEL, 6, 8, 100, 12
END

IDM_UI_RESOURCE_TEST MENU
BEGIN
    POPUP "中文菜单"
    BEGIN
        MENUITEM "中文菜单项", IDM_UI_RESOURCE_COMMAND
    END
END
